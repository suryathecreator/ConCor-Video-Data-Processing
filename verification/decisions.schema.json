{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryathecreator/ConCor-Video-Data-Processing/verification/decisions.schema.json",
  "title": "ConCor video verification decisions",
  "type": "object",
  "required": [
    "schema_version",
    "source_fingerprint",
    "videos"
  ],
  "properties": {
    "schema_version": {
      "const": "concor-video-decisions-v1"
    },
    "source_fingerprint": {
      "type": "string"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor": {
      "type": "object"
    },
    "quick_keys_enabled": {
      "type": "boolean"
    },
    "selection_protocol": {
      "const": "selected_instructions_v1"
    },
    "suggestion_count": {
      "enum": [1, 3, 5, 10, "all"]
    },
    "videos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "undecided",
              "accepted",
              "rejected"
            ]
          },
          "selected_sample_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "accepted_sample_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "sampled_sample_id": {"type": "string"},
          "review_mode": {
            "const": "revos_preview_v1"
          },
          "preview_sample_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "preview_override_sample_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "allow_multiple": {"type": "boolean"},
          "instructions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "discarded": {
                  "type": "boolean"
                },
                "status": {
                  "enum": ["accepted", "rejected"]
                },
                "deleted_tracklet_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "groups": {
                  "type": "array"
                }
              }
            }
          }
        },
        "required": [
          "status",
          "instructions"
        ]
      }
    }
  }
}
