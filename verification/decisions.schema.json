{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryathecreator/ConCor-Video-Data-Processing/verification/decisions.schema.json",
  "title": "ConCor video verification decisions",
  "type": "object",
  "required": [
    "schema_version",
    "source_fingerprint",
    "videos"
  ],
  "properties": {
    "schema_version": {
      "const": "concor-video-decisions-v1"
    },
    "source_fingerprint": {
      "type": "string"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cursor": {
      "type": "object"
    },
    "quick_keys_enabled": {
      "type": "boolean"
    },
    "videos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "undecided",
              "accepted",
              "rejected"
            ]
          },
          "instructions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "discarded": {
                  "type": "boolean"
                },
                "deleted_tracklet_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "groups": {
                  "type": "array"
                }
              }
            }
          }
        },
        "required": [
          "status",
          "instructions"
        ]
      }
    }
  }
}
