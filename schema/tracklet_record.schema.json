{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryathecreator/ConCor-Video-Data-Processing/schema/tracklet_record.schema.json",
  "title": "ConCor video tracklet correspondence record",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "dataset",
    "split",
    "cohort",
    "video_id",
    "expression_id",
    "text",
    "negative",
    "frame_ids",
    "tracklets",
    "groups",
    "span_links",
    "disposition"
  ],
  "properties": {
    "schema_version": {"const": "concor-video-tracklet-bcc-v2"},
    "sample_id": {"type": "string", "minLength": 1},
    "dataset": {"enum": ["ref_youtube_vos", "revos"]},
    "split": {"enum": ["train", "val", "test"]},
    "cohort": {"type": "string"},
    "video_id": {"type": "string"},
    "expression_id": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "negative": {"type": "boolean"},
    "frame_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frame_files": {"type": "array", "items": {"type": "string"}},
    "tracklets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tracklet_id", "source", "confidence", "present_frames", "masks"],
        "properties": {
          "tracklet_id": {"type": "string"},
          "source": {
            "enum": ["ground_truth", "sam3.1_main_referent", "sam3.1_context"]
          },
          "source_annotation_id": {"type": ["string", "null"]},
          "sam_prompt": {"type": ["string", "null"]},
          "confidence": {"type": "number"},
          "present_frames": {"type": "integer", "minimum": 0},
          "masks": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["size", "counts"],
                  "properties": {
                    "size": {
                      "type": "array",
                      "prefixItems": [
                        {"type": "integer", "minimum": 1},
                        {"type": "integer", "minimum": 1}
                      ],
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "counts": {"type": "array", "items": {"type": "integer", "minimum": 0}}
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "groups": {"type": "array"},
    "span_links": {"type": "array"},
    "disposition": {
      "enum": [
        "complete_bcc",
        "incomplete_context",
        "missing_main_referent",
        "negative_unsegmentable"
      ]
    }
  }
}
