# Required model inputs
SAM31_REPO_ROOT=/path/to/facebookresearch/sam3
SAM31_CHECKPOINT=/path/to/sam3.1_multiplex.pt

# Optional persistent caches (keep these off $HOME on shared clusters)
CONCOR_CACHE_ROOT=/path/to/persistent/cache/concor-video
HF_HOME=/path/to/persistent/cache/huggingface

# Optional Slurm defaults
SLURM_PARTITION=your_gpu_partition
SLURM_ACCOUNT=your_gpu_account
GPU_GRES=gpu:1
NUM_WORKERS=32
